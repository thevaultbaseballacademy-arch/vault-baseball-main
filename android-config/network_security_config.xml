<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Place this file at: android/app/src/main/res/xml/network_security_config.xml
  
  This config ensures HTTPS-only connections and pins Supabase + Stripe.
-->
<network-security-config>
    <!-- Block all HTTP traffic by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Allow Supabase domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">supabase.co</domain>
        <domain includeSubdomains="true">supabase.in</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    
    <!-- Allow Stripe -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">stripe.com</domain>
        <domain includeSubdomains="true">stripecdn.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
